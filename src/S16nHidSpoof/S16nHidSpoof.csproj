<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>S16nHidSpoof</RootNamespace>
    <AssemblyName>s16n-hid-spoof</AssemblyName>
    <!-- AssemblyVersion stays numeric; InformationalVersion is YYYYMMDD-&lt;git&gt; (see target below). -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <StartupObject>S16nHidSpoof.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Framework-dependent: installer installs .NET 10 runtimes if missing. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Allow restore/compile on non-Windows agents; run only on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <Target Name="SetInformationalVersionFromGit"
          BeforeTargets="GenerateAssemblyInfo;GetAssemblyVersion"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRevParseOut" />
    </Exec>
    <PropertyGroup>
      <_GitShort>$([System.String]::Copy('$(_GitRevParseOut)').Trim())</_GitShort>
      <_GitShort Condition="'$(_GitShort)' == '' OR $(_GitShort.Contains(' '))">unknown</_GitShort>
      <_BuildStamp>$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</_BuildStamp>
      <InformationalVersion>$(_BuildStamp)-$(_GitShort)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="high" Text="InformationalVersion=$(InformationalVersion)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="Nefarius.Drivers.HidHide" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>..\..\lib\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- Loose copies for installer staging; also embedded so WinForms always finds them. -->
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <EmbeddedResource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\logo.png" />
  </ItemGroup>
</Project>
